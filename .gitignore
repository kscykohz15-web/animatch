# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 検査を .claude/video の中で走らせると、作業フォルダと画像がここに出来る。
# 一度 382ファイル（PNG 込み）をコミットしかけた。成果物は git に入れない。
.claude/video/__pycache__/
.claude/video/_文脈検査/
.claude/video/_直す検査/
.claude/video/_ずれ検査/
.claude/video/_絵と字幕/
.claude/video/_見本/

# ---------------------------------------------------------------------------
# Supabase（必須）
# Supabase のプロジェクト設定 → API から取得する
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# service_role キー。サーバー側でのみ使用する（絶対に公開しない）。
# Gmail のリフレッシュトークンの読み書きに使う。
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# Gmail 連携（Amazon・楽天の注文メール取り込みを使う場合のみ）
# Google Cloud Console → APIとサービス → 認証情報 → OAuth クライアント ID（ウェブアプリケーション）
# 承認済みのリダイレクト URI に <アプリのURL>/api/gmail/callback を登録する
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# ---------------------------------------------------------------------------
# アプリの公開 URL。OAuth のリダイレクト先に使う。
# ローカル開発では http://localhost:3000、Vercel では https://<プロジェクト>.vercel.app
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
